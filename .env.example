# Copy to .env.local and fill in. Everything is optional — without it the app runs fully local.

# Supabase (Settings → API). The anon/publishable key is public by design; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web push public key (generate a pair with: npx web-push generate-vapid-keys).
# The matching private key goes ONLY into Supabase function secrets, never here in the app.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional USDA FoodData Central key — used server-side only by /api/foods/search.
USDA_API_KEY=

# Native app (Capacitor): URL of the deployed web app the shell loads, and the API base for food search.
CAP_SERVER_URL=
NEXT_PUBLIC_API_BASE=
